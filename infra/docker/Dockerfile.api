FROM rust:1.94.0-slim-bookworm AS chef
RUN cargo install cargo-chef
WORKDIR /app

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY infra/migrations/ infra/migrations/
# Compiled in by crates/worker/src/form_auto/candidates.rs (include_str!); scripts/check-docker-includes.py guards this.
COPY scripts/forms/auto/candidates.sql scripts/forms/auto/candidates.sql
# Only the runtime binaries; assistant-eval is a developer/CI tool.
RUN cargo build --release -p api --bin api --bin api-migrate --bin form-auto-import

# Agent intent classifier encoder: intfloat/multilingual-e5-small (MIT) at a
# pinned Hugging Face revision, sha256-verified (the API verifies the same
# pins at startup). Not in git: ~488 MB. Cached as its own layer.
FROM debian:bookworm-slim AS intent-model
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /model
RUN set -eu; \
    base=https://huggingface.co/intfloat/multilingual-e5-small/resolve/614241f622f53c4eeff9890bdc4f31cfecc418b3; \
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o model.safetensors "$base/model.safetensors"; \
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o tokenizer.json "$base/tokenizer.json"; \
    printf '%s  %s\n' \
      1a55775f53449dac10a2bcbc312469fac40b96d53198c407081a831f81c98477 model.safetensors \
      0b44a9d7b51c3c62626640cda0e2c2f70fdacdc25bbbd68038369d14ebdf4c39 tokenizer.json \
      | sha256sum -c -

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*
RUN useradd -m appuser
COPY --from=builder /app/target/release/api /usr/local/bin/api
COPY --from=builder /app/target/release/api-migrate /usr/local/bin/api-migrate
COPY --from=builder /app/target/release/form-auto-import /usr/local/bin/form-auto-import
COPY infra/migrations/ /app/infra/migrations/
COPY --from=intent-model /model/ /opt/mazimi/intent-classifier/
COPY crates/api/assets/intent-classifier/classifier.json /opt/mazimi/intent-classifier/classifier.json
COPY crates/api/assets/understanding/understanding.json /opt/mazimi/intent-classifier/understanding.json
USER appuser
EXPOSE 8080
CMD ["api"]
