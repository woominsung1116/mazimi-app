FROM rust:1.94.0-slim-bookworm AS chef
RUN cargo install cargo-chef
WORKDIR /app

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY infra/migrations/ infra/migrations/
# Compiled in by crates/worker/src/form_auto/candidates.rs (include_str!); scripts/check-docker-includes.py guards this.
COPY scripts/forms/auto/candidates.sql scripts/forms/auto/candidates.sql
RUN cargo build --release -p mazimi-worker --bins

FROM debian:bookworm-slim AS runtime
# poppler-utils: pdftotext reads the first page of a downloaded PDF form
# (application_resources::form_check), in a child process.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 poppler-utils && rm -rf /var/lib/apt/lists/*
RUN useradd -m appuser
COPY --from=builder /app/target/release/worker /usr/local/bin/worker
COPY --from=builder /app/target/release/seed-official-candidates /usr/local/bin/seed-official-candidates
COPY --from=builder /app/target/release/revalidate-benefits /usr/local/bin/revalidate-benefits
COPY --from=builder /app/target/release/renormalize-snapshots /usr/local/bin/renormalize-snapshots
COPY --from=builder /app/target/release/enrich-benefit-candidates /usr/local/bin/enrich-benefit-candidates
COPY --from=builder /app/target/release/import-applicant-reviews /usr/local/bin/import-applicant-reviews
COPY --from=builder /app/target/release/import-condition-reviews /usr/local/bin/import-condition-reviews
COPY --from=builder /app/target/release/confirm-rolling-windows /usr/local/bin/confirm-rolling-windows
COPY --from=builder /app/target/release/convert-pilot-condition-reviews /usr/local/bin/convert-pilot-condition-reviews
COPY --from=builder /app/target/release/convert-stored-condition-reviews /usr/local/bin/convert-stored-condition-reviews
USER appuser
COPY --from=builder /app/target/release/revalidate-application-resources /usr/local/bin/revalidate-application-resources
COPY --from=builder /app/target/release/reject-application-resource-noise /usr/local/bin/reject-application-resource-noise
COPY --from=builder /app/target/release/undo-download-forms /usr/local/bin/undo-download-forms
COPY --from=builder /app/target/release/corporate-census /usr/local/bin/corporate-census
COPY --from=builder /app/target/release/form-auto /usr/local/bin/form-auto
COPY --from=builder /app/target/release/rule-health /usr/local/bin/rule-health
CMD ["worker"]
