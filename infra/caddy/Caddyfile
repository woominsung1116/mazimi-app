# Redirect www to apex domain
www.{$DOMAIN:localhost} {
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN:localhost} {
    # Canonical API routes keep Axum's /api/v1 prefix intact.
    handle /api/v1/* {
        reverse_proxy api:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    # Compatibility for previous /api/api/v1 clients and /api/health probes.
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # All other traffic goes to Next.js. Its /bff proxy also caps bodies at
    # 1 MiB (the API's limit) while streaming; Caddy refuses larger first.
    handle {
        request_body {
            max_size 1MiB
        }
        reverse_proxy web:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    encode gzip

    # Security headers
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-XSS-Protection "1; mode=block"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
        -X-Powered-By
    }

    # Request access logging is disabled: OAuth query codes and search terms
    # must not enter durable proxy logs. Service errors and metrics remain.
}

{$APP_DOMAIN:app.localhost} {
    handle /api/v1/* {
        reverse_proxy api:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        root * /srv/mobile
        try_files {path} {path}.html {path}/index.html /index.html
        file_server
    }
    encode gzip
    # The Expo web export calls the API on the main domain, checks
    # connectivity at www.gstatic.com, and injects styles at runtime
    # (react-native-web). Its only inline script is the router hydrate flag,
    # allowed by hash; scripts/check-app-csp.py fails CI when an export adds
    # an inline script this policy does not allow.
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-67fhrP0+BkBqmgGGXTtgiVO/9EQs3QruYNU/7fnRkI8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://{$DOMAIN} https://www.gstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        -Server
    }
}
