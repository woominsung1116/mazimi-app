# =============================================================================
# Database (Supabase managed PG in production)
# =============================================================================
DATABASE_MODE=local
# Supabase long-running services must use direct/session mode on port 5432,
# not the transaction pooler on port 6543. Add sslmode=require in production.
DATABASE_URL=postgres://wello:wello@db:5432/wello
DB_PASSWORD=wello_secret
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deployment backup policy
PRE_DEPLOY_BACKUP=true
BACKUP_RETENTION_DAYS=7
USE_S3=false
S3_BUCKET=
S3_ENDPOINT_URL=

# =============================================================================
# Auth
# =============================================================================
JWT_SECRET=change-me-in-production
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# =============================================================================
# AI
# =============================================================================
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_SUMMARY=
AI_MODEL_REASONING=

# =============================================================================
# API Keys (공공데이터포털 / 외부 API)
# =============================================================================
# data.go.kr 키는 반드시 "Decoding" 키(마이페이지의 일반 인증키, URL 디코딩된
# 원문)를 넣는다. 워커가 쿼리 파라미터로 다시 인코딩하므로 "Encoding" 키를 넣으면
# 이중 인코딩되어 401로 즉시 실패한다. GOV_BENEFITS/KOSAF/FTC/WELFARE 키 모두 동일.
# data.go.kr 일반 공공 API 디코딩 키
GOV_API_KEY=your_data_go_kr_decoding_key
# 복지로 혜택 API 키
GOV_BENEFITS_API_KEY=your_data_go_kr_decoding_key
# 청년정책포털 API 키
YOUTH_CENTER_API_KEY=your_youth_center_api_key
# 워크넷 API 키
WORKNET_API_KEY=your_data_go_kr_decoding_key
# 한국장학재단(KOSAF) API 키
KOSAF_API_KEY=your_data_go_kr_decoding_key
# 금융감독원(FSS) API 키
FSS_API_KEY=your_fss_api_key
# 공정거래위원회 가맹 브랜드 목록 API 키 (미설정 시 GOV_API_KEY 사용)
FTC_BRAND_API_KEY=your_data_go_kr_decoding_key
# data.go.kr 운영계 활용 승인을 받은 뒤에만 true
FTC_BRAND_PRODUCTION_APPROVED=false
SOURCE_REVIEW_GRACE_HOURS=72
SOURCE_REVIEW_SWEEP_LIMIT=100
# 최신 제공 기준년도에 맞춰 조정 (미설정 시 전년도)
FTC_BRAND_BASE_YEAR=2025

# =============================================================================
# Worker — Notifications
# =============================================================================
# Kakao Alimtalk (카카오 비즈메시지)
KAKAO_BIZ_API_KEY=
KAKAO_BIZ_SENDER_KEY=
KAKAO_ALIMTALK_TEMPLATE_CODE=

# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_ACCESS_TOKEN=your_fcm_token

# 한국사회보장정보원 복지서비스 API (data.go.kr 디코딩 키)
NATIONAL_WELFARE_API_KEY=your_data_go_kr_decoding_key
LOCAL_WELFARE_API_KEY=your_data_go_kr_decoding_key

# Worker — compliance-approved public benefit pages
# Disabled by default. Enabling this flag alone is not enough: each domain must
# also have a current admin approval, allowed paths, and an allowed robots check.
BENEFIT_CRAWLER_ENABLED=false
BENEFIT_CRAWLER_TIMEOUT_SECS=20
BENEFIT_CRAWLER_MAX_BODY_BYTES=1048576
BENEFIT_CRAWLER_MAX_PAGES=20
BENEFIT_CRAWLER_MAX_LINKS_PER_PAGE=50

# Optional LLM extraction creates admin-only drafts and never publishes.
# It remains off even when GEMINI_API_KEY is present.
BENEFIT_LLM_ENABLED=false
BENEFIT_LLM_PROVIDER=gemini
BENEFIT_LLM_MODEL=gemini-3.1-flash-lite
BENEFIT_LLM_TIMEOUT_SECS=30
BENEFIT_LLM_MAX_CANDIDATES=10
GEMINI_API_KEY=

# User-facing assistant: grounded Q&A quotes stored notice text and always
# works without a model. The optional AI summary (opt-in, streamed, validated,
# private Ollama, no external provider) stays off until the flag-on criteria
# in docs/mazimi-ai-assistant-v1-contract.md are met. Flags accept true/1/yes/on.
ASSISTANT_AI_ENABLED=false
ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
ASSISTANT_AI_MODEL=qwen3.5:9b
# Whole-generation bound, 1-300 s (CPU summaries take 30-100 s).
ASSISTANT_AI_TIMEOUT_SECS=120
# Ollama keep_alive: -1 or <n>s|m|h. Bridges low-traffic gaps (no reload per question).
ASSISTANT_OLLAMA_KEEP_ALIVE=30m
# Preload the model at API start; failure only marks AI unavailable.
ASSISTANT_AI_WARMUP=false
# The endpoint must use port 11434 unless this is set.
ASSISTANT_OLLAMA_ALLOW_ANY_PORT=false
# Ollama options.num_thread (1-64), sent on every request. Ollama ignores its
# container cpuset and starts a thread per host core (~45x slower on a 2-3
# core cpuset), so set this to the CPU count of the Ollama cpuset. Empty =
# CPUs available to this process.
ASSISTANT_AI_NUM_THREADS=

# AI benefit agent (docs/mazimi-ai-agent.md). Off by default. With the agent
# on and ASSISTANT_AI_ENABLED off, only fast-path goals run (no model).
ASSISTANT_AGENT_ENABLED=false
# Model planner (only when ASSISTANT_AI_ENABLED): defaults to ASSISTANT_AI_MODEL.
# ASSISTANT_AGENT_PLANNER_MODEL=qwen3.5:9b
ASSISTANT_AGENT_PLAN_TIMEOUT_SECS=180
ASSISTANT_AGENT_RUN_TIMEOUT_SECS=300
# The progress stream says "backgrounded" after this; a push follows on completion.
ASSISTANT_AGENT_BACKGROUND_AFTER_SECS=20
ASSISTANT_AGENT_MAX_RUNS=8
# Intent classifier (agent routing step after the guard; docs/mazimi-ai-agent.md
# §2). Off by default. The API image carries its artefacts in
# /opt/mazimi/intent-classifier (sha256-pinned; a missing or different file
# disables it and routing falls back). Below the threshold the model planner
# (AI on) or the rules (AI off) decide. ~85 MB RSS, ~10-60 ms CPU per goal.
ASSISTANT_INTENT_CLASSIFIER_ENABLED=false
# ASSISTANT_INTENT_CLASSIFIER_DIR=/opt/mazimi/intent-classifier
# ASSISTANT_INTENT_CLASSIFIER_THREADS=2
# Override the artefact's calibrated 0.7 (0.5-0.99) only with a new measurement.
# ASSISTANT_INTENT_CLASSIFIER_THRESHOLD=0.7
# Conversation retention, purged hourly by the worker (1-90). Keep it equal to
# the privacy policy text (제6조의3: 30 days).
ASSISTANT_RETENTION_DAYS=30
# Worker: weekly briefing / change impact / resume pushes to opted-in users.
ASSISTANT_AGENT_PROACTIVE_ENABLED=false
# agent-tools-v3, each off by default (docs/mazimi-ai-agent.md §4); the
# production values are in .env.production.example.
# Live official-page check: also needs the isolated fetch service
# (compose profile `official-page`) and the shared token below.
ASSISTANT_AGENT_OFFICIAL_PAGE_ENABLED=false
# OFFICIAL_PAGE_MCP_URL=http://official-page:8090/mcp
# OFFICIAL_PAGE_MCP_TOKEN=<32+ random characters, same value for api and official-page>
ASSISTANT_AGENT_DOCUMENT_LINKS_ENABLED=false
ASSISTANT_AGENT_CALENDAR_ENABLED=false

# A-09 AI data curator (worker, 03:30-06:30 KST window, one batch a day): extracts eligibility-fact
# candidates with evidence from public program text for admin review only.
# Off until the rollout gates in docs/mazimi-ai-extraction.md pass.
EXTRACTION_AI_ENABLED=false
EXTRACTION_AI_URL=http://127.0.0.1:11434
EXTRACTION_AI_MODEL=qwen3.5:9b-q4_K_M
EXTRACTION_AI_TIMEOUT_SECS=180
EXTRACTION_AI_KEEP_ALIVE=5m
EXTRACTION_AI_MAX_PROGRAMS=8
EXTRACTION_AI_FAILURE_COOLDOWN_HOURS=6
EXTRACTION_AI_TIME_BUDGET_MINUTES=25
# extract | normalize_only (re-validate cached answers, no model call)
EXTRACTION_AI_MODE=extract
EXTRACTION_AI_ALLOW_ANY_PORT=false
# Ollama options.num_thread (1-64), sent on every request. Ollama ignores its
# container cpuset and starts a thread per host core (~45x slower on a 2-3
# core cpuset), so set this to the CPU count of the Ollama cpuset. Empty =
# CPUs available to this process.
EXTRACTION_AI_NUM_THREADS=
# Changed program text is queued by a DB trigger and drained hourly (0 = off).
EXTRACTION_AI_QUEUE_MAX_PROGRAMS=4
# Auto-apply of rule-verified facts (docs/mazimi-ai-extraction.md §14). Keep
# false until the extraction-eval --auto-gate passes on the human-verified set.
EXTRACTION_AUTO_APPLY_ENABLED=false
EXTRACTION_AUTO_APPLY_TYPES=age,application_window,document
EXTRACTION_AUTO_APPLY_MAX_PER_RUN=25
EXTRACTION_AUTO_AUDIT_PERCENT=10
EXTRACTION_AUTO_AUDIT_SEED=mazimi-auto-audit-v1

# Durable operational incidents are always stored in PostgreSQL. Webhook
# delivery is optional and remains disabled while the URL is empty.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_FORMAT=generic
OPS_ALERT_MIN_SEVERITY=warning
OPS_ALERT_MAX_BATCH=20
OPS_ALERT_DASHBOARD_URL=

# Callback base host (used by worker to build webhook/redirect URLs)
CALLBACK_HOST=localhost

# =============================================================================
# App
# =============================================================================
APP_ENV=local
APP_PORT=8080
DOMAIN=localhost
PUBLIC_API_BASE_URL=http://localhost:8080
API_RUN_MIGRATIONS_ON_STARTUP=true
API_DB_MAX_CONNECTIONS=8
WORKER_DB_MAX_CONNECTIONS=5
DB_CONNECT_ATTEMPTS=6
DB_CONNECT_TIMEOUT_SECS=10
DB_ACQUIRE_TIMEOUT_SECS=15
SHUTDOWN_GRACE_SECS=30
RUST_LOG=info

# =============================================================================
# Mobile (Expo / React Native)
# =============================================================================
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_KAKAO_CLIENT_ID=your_kakao_client_id
# Public application-resource discovery is opt-in and requires source-domain approvals.
APPLICATION_RESOURCES_ENABLED=false
APPLICATION_RESOURCES_MAX_CHECKS=20
APPLICATION_RESOURCES_SEED_LIMIT=200
# 복지로 detail API calls per hourly run (national quota 100/day, local 1,000/day)
APPLICATION_RESOURCES_WELFARE_NATIONAL_PER_RUN=3
APPLICATION_RESOURCES_WELFARE_LOCAL_PER_RUN=30
# Download-only official forms: off | dry_run | on. "on" needs the reviewer account id below.
APPLICATION_FORMS_PUBLISH=off
# A dedicated automatic account for this tier: not a person's id, not FORM_AUTO_ACTOR_USER_ID.
APPLICATION_FORMS_ACTOR_USER_ID=
# Ambiguous programme matches go to the local model: off | shadow (ask, record, publish nothing) | judge.
APPLICATION_FORMS_JUDGE=off
APPLICATION_FORMS_JUDGE_MODEL=qwen3:1.7b
APPLICATION_FORMS_JUDGE_URL=http://ollama:11434
APPLICATION_FORMS_JUDGE_MAX_CALLS=10
# The "신청" link resolver: candidate sync and polite link checks (robots,
# 1 req/s per host). Off by default; the API keeps official_url until it runs.
LINK_RESOLVER_ENABLED=false
LINK_RESOLVER_SYNC_LIMIT=600
LINK_RESOLVER_MAX_CHECKS=300

# Automatic 신청 entry points (crates/worker/src/application_resources/apply_entry):
# hourly at :32, reads each programme's official page structure, verifies the
# target twice (robots, 1 req/s per host, GET only) and stores verified links
# in program_application_resources. Off by default.
APPLY_LINKS_ENABLED=false
APPLY_LINKS_MAX_PROGRAMMES=150
APPLY_LINKS_CONFIRM_AFTER_MINUTES=60
# Optional closed yes/no tie-breaker on the local Ollama (unset: ties stay ambiguous).
APPLY_LINKS_JUDGE_MODEL=
APPLY_LINKS_JUDGE_URL=http://ollama:11434

# Optional 무주택 / 혼인·자녀 profile questions (web build arg and mobile).
# Off until a served rule reads the answers.
PROFILE_CONDITION_QUESTIONS_ENABLED=false
EXPO_PUBLIC_PROFILE_CONDITION_QUESTIONS_ENABLED=false
# Optional 소득 구간 (기준 중위소득 %) question. On: matching reads income_median_band.
INCOME_QUESTION_ENABLED=true
EXPO_PUBLIC_INCOME_QUESTION_ENABLED=true

# Corporate doors (crates/worker/src/corporate_auto/doors): off | shadow | live.
# Live publishes only the kinds listed (page, listing, hub_rows) and only while
# CORPORATE_INTAKE_MODE=live. A hub is read only once its domain's
# terms_review_outcome is recorded as allowing it.
CORPORATE_DOORS_MODE=off
CORPORATE_DOOR_KINDS_LIVE=
CORPORATE_DOOR_FLAG_PAYCO=false
