# The public API origin (MAZIMI_API_URL in docs/ops-env.md). Public URL only; never put
# secrets in EXPO_PUBLIC_*. EAS builds read it from the EAS environment of their profile.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Optional 무주택 / 혼인·자녀 questions; hidden unless "true".
EXPO_PUBLIC_PROFILE_CONDITION_QUESTIONS_ENABLED=false
# Optional 소득 구간 (기준 중위소득 %) question; shown unless "false".
EXPO_PUBLIC_INCOME_QUESTION_ENABLED=true
