{
  "expo": {
    "name": "마지미",
    "slug": "majimi",
    "version": "1.0.1",
    "owner": "mazimi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mazimi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/225a8c33-91f4-4993-beb6-1114b74b58fa"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#34BB84"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.mazimi.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#34BB84"
      },
      "package": "kr.mazimi.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "./plugins/withPodsDeploymentTarget",
        {
          "deploymentTarget": "15.1"
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withVaultBackupExclusion",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "신청 마감일 같은 혜택 일정을 이 기기 캘린더에 추가하려고 캘린더 권한을 요청해요.",
          "remindersPermission": "마지미는 미리 알림을 읽거나 쓰지 않아요. 캘린더 기능에 필요한 시스템 항목이에요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 163,
          "resizeMode": "contain",
          "backgroundColor": "#34BB84",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#34BB84"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "225a8c33-91f4-4993-beb6-1114b74b58fa"
      },
      "router": {
        "origin": false
      }
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#34BB84"
    }
  }
}
