# ============================================================
# Mazimi — Production Environment Variables
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.
# ============================================================

# ----------------------------------------------------------
# Domain (used by Caddy TLS and NEXT_PUBLIC_API_BASE_URL)
# ----------------------------------------------------------
# Your public domain name, no scheme, no trailing slash.
# Example: mazimi.kr
DOMAIN=mazimi.kr

# ----------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------
# Full DSN used by SQLx in the api and worker services.
# local: starts the compose `db` service; external: Supabase or another PG.
DATABASE_MODE=local
# For a long-running API/worker on Supabase, use the direct connection or the
# session pooler on port 5432. Do not use the transaction pooler on port 6543:
# it does not support the prepared statements used by SQLx.
# Add sslmode=require for Supabase.
DATABASE_URL=postgres://wello:CHANGE_ME@db:5432/wello

# Bounded SQLx pool/retry policy. Keep the combined API + worker connection
# count within the database/provider plan's connection allowance.
API_DB_MAX_CONNECTIONS=8
WORKER_DB_MAX_CONNECTIONS=5
JOB_DB_MAX_CONNECTIONS=2
DB_MIN_CONNECTIONS=0
DB_CONNECT_ATTEMPTS=6
DB_CONNECT_TIMEOUT_SECS=10
DB_ACQUIRE_TIMEOUT_SECS=15
DB_IDLE_TIMEOUT_SECS=300
DB_MAX_LIFETIME_SECS=1800

# Password for the local postgres service (compose.yml db service).
# Ignored when DATABASE_URL points to an external host.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Create a verified dump before every schema migration. For OCI, point the
# optional S3 target at an off-VM bucket so a boot-volume loss is recoverable.
PRE_DEPLOY_BACKUP=true
BACKUP_RETENTION_DAYS=7
USE_S3=false
S3_BUCKET=
S3_ENDPOINT_URL=

# ----------------------------------------------------------
# Kakao OAuth (소셜 로그인)
# ----------------------------------------------------------
# From Kakao Developers → 앱 → 앱 키 → REST API 키
KAKAO_CLIENT_ID=CHANGE_ME
# From Kakao Developers → 앱 → 보안 → Client Secret
KAKAO_CLIENT_SECRET=CHANGE_ME

# Google Auth Platform → 웹 애플리케이션 OAuth 클라이언트.
# Empty values keep the Google button unavailable. See docs/mazimi-google-login-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------
# JWT (Axum API)
# ----------------------------------------------------------
# Shared secret for signing/verifying JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET

# Server-side canonical origin; callbacks already include /api/v1/auth/....
# compose.yml derives this from DOMAIN and passes it to the API container.
PUBLIC_API_BASE_URL=https://mazimi.kr
API_RUN_MIGRATIONS_ON_STARTUP=false
SHUTDOWN_GRACE_SECS=30

# Supabase is reached only through DATABASE_URL. No service reads a Supabase
# API key, so do not put SUPABASE_SERVICE_ROLE_KEY (or the anon key) here.
#
# compose.yml passes each service an explicit allowlist of these names, not
# the whole file. A new variable reaches a container only after its name is
# added there (scripts/check-service-env.py checks it in CI).

# ----------------------------------------------------------
# Corporate-benefit discovery (worker)
# ----------------------------------------------------------
# FTC franchise catalogue. Keep production disabled until data.go.kr approves
# the production-use request.
FTC_BRAND_API_KEY=
FTC_BRAND_PRODUCTION_APPROVED=false
FTC_BRAND_BASE_YEAR=2025

SOURCE_REVIEW_GRACE_HOURS=72
SOURCE_REVIEW_SWEEP_LIMIT=100

# Public crawler policy page, placed in every bot user agent (corporate
# crawler and the official-API clients). https, must resolve. Unset or
# invalid, the API clients fall back to the policy page on the current host.
CORPORATE_BOT_CONTACT_URL=https://CHANGE_ME_PUBLIC_HOST/crawler-policy
# Publisher opt-out form (POST /api/v1/publisher/opt-out). The api takes
# requests, the worker checks the proof file hourly; a request changes
# nothing until the publisher serves its token on the domain.
PUBLISHER_OPTOUT_ENABLED=false

# Direct page collection remains separately gated per domain and is off by
# default. Enabling this flag alone never grants a domain permission.
BENEFIT_CRAWLER_ENABLED=false
BENEFIT_CRAWLER_TIMEOUT_SECS=20
BENEFIT_CRAWLER_MAX_BODY_BYTES=1048576
BENEFIT_CRAWLER_MAX_PAGES=20
BENEFIT_CRAWLER_MAX_LINKS_PER_PAGE=50

# Optional, admin-draft-only structured extraction. Keep false until the
# provider data-processing terms, budget, and output quality are reviewed.
BENEFIT_LLM_ENABLED=false
BENEFIT_LLM_PROVIDER=gemini
BENEFIT_LLM_MODEL=gemini-3.1-flash-lite
BENEFIT_LLM_TIMEOUT_SECS=30
BENEFIT_LLM_MAX_CANDIDATES=10
GEMINI_API_KEY=

# User assistant ships grounded Q&A (quotes only). Enable the AI summary
# only after the numeric flag-on criteria in
# docs/mazimi-ai-assistant-v1-contract.md are met on the production host.
# This hostname requires a separately provisioned, private Ollama service
# (OLLAMA_NUM_PARALLEL=1, OLLAMA_DEBUG unset; see the contract's ops limits).
ASSISTANT_AI_ENABLED=false
ASSISTANT_OLLAMA_URL=http://ollama:11434
ASSISTANT_AI_MODEL=qwen3.5:9b
# Whole-generation bound, 1-300 s (CPU summaries take 30-100 s).
ASSISTANT_AI_TIMEOUT_SECS=120
# Ollama keep_alive: -1 or <n>s|m|h. Bridges low-traffic gaps (no reload per question).
ASSISTANT_OLLAMA_KEEP_ALIVE=30m
# Preload the model at API start; failure only marks AI unavailable.
ASSISTANT_AI_WARMUP=false
# The endpoint must use port 11434 unless this is set.
ASSISTANT_OLLAMA_ALLOW_ANY_PORT=false
# Ollama options.num_thread (1-64), sent on every request. Ollama ignores its
# container cpuset and starts a thread per host core (~45x slower on a 2-3
# core cpuset): keep this equal to the CPU count of OLLAMA_CPUSET / OLLAMA_CPUS
# (infra/docker/compose.ollama.yml default "2,3" / 2 -> 2).
ASSISTANT_AI_NUM_THREADS=2

# The one kill switch for every model call (answer model, agent planner,
# intent classifier, search reranker, write understanding): set it to false
# and no model runs (writes are then read by the lexical rules); unset, each
# model follows its own flag below.
# ASSISTANT_MODELS_ENABLED=false

# AI benefit agent (docs/mazimi-ai-agent.md). Off by default. With the agent
# on and both ASSISTANT_AI_ENABLED and ASSISTANT_AGENT_PLANNER_ENABLED off,
# only fast-path goals run (no model).
ASSISTANT_AGENT_ENABLED=false
# Kill switches, default on: false turns off the 신청 준비 journey's vault
# match and draft card, or the card producer (the intent layer's writes
# merged into every plan; then only planned writes that pass the gate are
# cards).
# ASSISTANT_AGENT_JOURNEY_ENABLED=true
# ASSISTANT_CARD_PRODUCER_ENABLED=true
# Model planner: with ASSISTANT_AI_ENABLED (shares the answer model's Ollama;
# defaults to ASSISTANT_AI_MODEL), or on its own with
# ASSISTANT_AGENT_PLANNER_ENABLED (the fine-tuned planner service in
# infra/docker/compose.planner.yml; answers stay template-only).
# ASSISTANT_AGENT_PLANNER_MODEL=qwen3.5:9b
ASSISTANT_AGENT_PLANNER_ENABLED=false
# The fine-tuned planner: compose.planner.yml sets the URL to http://planner:11434.
# ASSISTANT_AGENT_PLANNER_MODEL=mazimi-planner-q17-v2
# tuned = the short system turn the model was trained with; few-shot = stock models.
# ASSISTANT_AGENT_PLANNER_PROMPT=tuned
# The planner model's Ollama digest (sha256:...). Set, the planner stays off until
# the served model matches it; a mismatch turns it off and logs one warning.
# ASSISTANT_AGENT_PLANNER_DIGEST=8a7e88aaa0c614b2110ead6a51bbc3c1ffbe6a95b651e9cd75f21401fa892a1b
# = CPU count of PLANNER_CPUSET (default "2,3" -> 2); else ASSISTANT_AI_NUM_THREADS.
# ASSISTANT_AGENT_PLANNER_NUM_THREADS=2
# A model refusal gets the rules' answer or a not-understood reply; refusing
# stays with the guard and the classifier (the classifier is off by default,
# so production has no fraud/misreport refusal: such goals route as usual and
# any write is still a confirmation card). Keep false: the tuned planner
# refused honest goals that name fraud terms (3 of 16 on dev).
ASSISTANT_AGENT_PLANNER_REFUSALS=false
# PLANNER_OLLAMA_IMAGE=ollama/ollama:0.40.3
# PLANNER_MODEL_DIR=/opt/mazimi/planner
# One plan call. Unset: 180 s, or 12 s with ASSISTANT_AGENT_PLANNER_PROMPT=tuned
# (the 1.7B planner's arm64 p95 is about 1 s; one hung call holds its slot).
# ASSISTANT_AGENT_PLAN_TIMEOUT_SECS=180
ASSISTANT_AGENT_RUN_TIMEOUT_SECS=300
# The progress stream says "backgrounded" after this; a push follows on completion.
ASSISTANT_AGENT_BACKGROUND_AFTER_SECS=20
ASSISTANT_AGENT_MAX_RUNS=8
# Intent classifier (agent routing step after the guard; docs/mazimi-ai-agent.md
# §2). Off by default. The API image carries its artefacts in
# /opt/mazimi/intent-classifier (sha256-pinned; a missing or different file
# disables it and routing falls back). Below the threshold the model planner
# (AI on) or the rules (AI off) decide. ~85 MB RSS, ~10-60 ms CPU per goal.
ASSISTANT_INTENT_CLASSIFIER_ENABLED=false
# ASSISTANT_INTENT_CLASSIFIER_DIR=/opt/mazimi/intent-classifier
# ASSISTANT_INTENT_CLASSIFIER_THREADS=2
# Override the artefact's calibrated 0.7 (0.5-0.99) only with a new measurement.
# ASSISTANT_INTENT_CLASSIFIER_THRESHOLD=0.7
# Write understanding (docs/mazimi-ai-agent.md §4): one local model reads
# which writes a goal asks for (act, direction, target); a pure policy
# vetoes and resolves, and every write is still a confirmation card. On by
# default; it shares the classifier's encoder files in
# /opt/mazimi/intent-classifier plus understanding.json (sha256-pinned).
# While it loads, if its artefact fails, with this flag off, or with
# ASSISTANT_MODELS_ENABLED=false, the lexical rules read writes (the AI-off
# fallback). ~22 MB artefact, p95 ~12 ms per goal on 4 arm64 cores.
ASSISTANT_UNDERSTANDING_ENABLED=true
# ASSISTANT_UNDERSTANDING_DIR=/opt/mazimi/intent-classifier
# ASSISTANT_UNDERSTANDING_THREADS=2
# Search relevance reranker (needs the classifier's encoder): reorders a
# search's candidates by e5 similarity to its topic words and drops off-topic
# rows (services/relevance.rs). The catalogue is embedded in the background
# at start and hourly (~13k rows).
ASSISTANT_SEARCH_RERANK_ENABLED=false
# Turning it on: also start the API with the CPU overlay, which pins it to
# CPUs 0-1 apart from Ollama's 2,3 (the base compose.yml leaves the API
# unpinned):
#   docker compose -f compose.yml -f infra/docker/compose.classifier.yml up -d api
# API_CPUSET=0,1
# Conversation retention, purged hourly by the worker (1-90). Keep it equal to
# the privacy policy text (제6조의3: 30 days).
ASSISTANT_RETENTION_DAYS=30
# Worker: weekly briefing / change impact / resume pushes to opted-in users.
ASSISTANT_AGENT_PROACTIVE_ENABLED=false
# agent-tools-v3: off by default in code; the production values below
# (docs/mazimi-ai-agent.md §13 step 7: order, checks, rollback = set false).
# Live official-page check: also needs the isolated fetch service
# (compose profile `official-page`) and the shared token below. Without
# them the tool answers "지금 공식 페이지를 확인하지 못했어요" with the link.
ASSISTANT_AGENT_OFFICIAL_PAGE_ENABLED=true
OFFICIAL_PAGE_MCP_URL=http://official-page:8090/mcp
# 32+ random characters, the same value for api and official-page
# (scripts/deploy.sh generates it while it is CHANGE_ME).
OFFICIAL_PAGE_MCP_TOKEN=CHANGE_ME_OFFICIAL_PAGE_TOKEN
ASSISTANT_AGENT_DOCUMENT_LINKS_ENABLED=true
ASSISTANT_AGENT_CALENDAR_ENABLED=true

# A-09 AI data curator (worker, 03:30-06:30 KST window, one batch a day): extracts eligibility-fact
# candidates with evidence from public program text for admin review only.
# Off until the rollout gates in docs/mazimi-ai-extraction.md pass.
EXTRACTION_AI_ENABLED=false
EXTRACTION_AI_URL=http://ollama:11434
EXTRACTION_AI_MODEL=qwen3.5:9b-q4_K_M
EXTRACTION_AI_TIMEOUT_SECS=180
EXTRACTION_AI_KEEP_ALIVE=5m
EXTRACTION_AI_MAX_PROGRAMS=8
EXTRACTION_AI_FAILURE_COOLDOWN_HOURS=6
EXTRACTION_AI_TIME_BUDGET_MINUTES=25
# extract | normalize_only (re-validate cached answers, no model call)
EXTRACTION_AI_MODE=extract
EXTRACTION_AI_ALLOW_ANY_PORT=false
# Ollama options.num_thread (1-64), sent on every request. Ollama ignores its
# container cpuset and starts a thread per host core (~45x slower on a 2-3
# core cpuset): keep this equal to the CPU count of OLLAMA_CPUSET / OLLAMA_CPUS
# (infra/docker/compose.ollama.yml default "2,3" / 2 -> 2).
EXTRACTION_AI_NUM_THREADS=2
# Changed program text is queued by a DB trigger and drained hourly (0 = off).
EXTRACTION_AI_QUEUE_MAX_PROGRAMS=4
# Auto-apply of rule-verified facts (docs/mazimi-ai-extraction.md §14). Keep
# false until the extraction-eval --auto-gate passes on the human-verified set.
EXTRACTION_AUTO_APPLY_ENABLED=false
EXTRACTION_AUTO_APPLY_TYPES=age,application_window,document
EXTRACTION_AUTO_APPLY_MAX_PER_RUN=25
EXTRACTION_AUTO_AUDIT_PERCENT=10
EXTRACTION_AUTO_AUDIT_SEED=mazimi-auto-audit-v1

# Optional operator alerts (generic JSON, Slack, or Discord). Incidents remain
# visible in the admin UI even when webhook delivery is not configured.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_FORMAT=generic
OPS_ALERT_MIN_SEVERITY=warning
OPS_ALERT_MAX_BATCH=20
OPS_ALERT_DASHBOARD_URL=https://mazimi.kr/admin/operations
# Email alerts: error/critical incidents (deduplicated, one reminder a day while
# recurring) plus a Korean daily digest at 09:00 KST. Gmail needs an app
# password (Google account > Security > 2-Step Verification > App passwords).
OPS_ALERT_EMAIL_TO=
OPS_ALERT_EMAIL_MIN_SEVERITY=error
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
# Gmail app password; spaces are stripped.
SMTP_PASSWORD=
SMTP_FROM=

# Storage upkeep (worker daily job). Retention deletes only ingestion_items.
INGESTION_ITEMS_RETENTION_ENABLED=true
INGESTION_ITEMS_RETENTION_DAYS=14
DB_SIZE_WARN_MB=420
DB_SIZE_ERROR_MB=470
HOST_DISK_WARN_GB=20
HOST_DISK_ERROR_GB=10
# Source output guard: optional per-source floor of served programmes.
# SOURCE_ACTIVE_FLOOR_YOUTH_CENTER=500
SOURCE_ACTIVE_MAX_DROP_PCT=30
# Scholarship: follow the newest valid dataset file (false pins the old one).
SCHOLARSHIP_DATASET_AUTO=true
# Domain approvals: off by default. When true, only public_facts_review approvals
# with no terms page renew, and only on byte-identical robots.txt.
DOMAIN_APPROVAL_AUTO_RENEW=false
DOMAIN_APPROVAL_RENEW_WITHIN_DAYS=30

# ----------------------------------------------------------
# Kakao Biz / AlimTalk (알림톡, optional)
# ----------------------------------------------------------
KAKAO_BIZ_API_KEY=
KAKAO_BIZ_SENDER_KEY=

# ----------------------------------------------------------
# Firebase Cloud Messaging (푸시 알림, optional)
# ----------------------------------------------------------
FCM_PROJECT_ID=
# The worker reads a short-lived OAuth2 access token (crates/worker/src/notifications/fcm.rs).
# It is not refreshed by the worker; service-account refresh is not implemented yet.
FCM_ACCESS_TOKEN=
# Reuses approved source domains. Does not grant submission or file-republication rights.
APPLICATION_RESOURCES_ENABLED=false
APPLICATION_RESOURCES_MAX_CHECKS=20
APPLICATION_RESOURCES_SEED_LIMIT=200
# The "신청" link resolver (crates/worker/src/link_resolver): hourly candidate
# sync and link checks that honour robots.txt and pace 1 req/s per host.
LINK_RESOLVER_ENABLED=false
LINK_RESOLVER_SYNC_LIMIT=600
LINK_RESOLVER_MAX_CHECKS=300

# Automatic 신청 entry points (crates/worker/src/application_resources/apply_entry):
# hourly at :32, reads each programme's official page structure, verifies the
# target twice (robots, 1 req/s per host, GET only) and stores verified links
# in program_application_resources. Off by default.
APPLY_LINKS_ENABLED=false
APPLY_LINKS_MAX_PROGRAMMES=150
APPLY_LINKS_CONFIRM_AFTER_MINUTES=60
# Optional closed yes/no tie-breaker on the local Ollama (unset: ties stay ambiguous).
APPLY_LINKS_JUDGE_MODEL=
APPLY_LINKS_JUDGE_URL=http://ollama:11434

# Corporate doors (crates/worker/src/corporate_auto/doors): off | shadow | live.
# Live publishes only the kinds listed (page, listing, hub_rows) and only while
# CORPORATE_INTAKE_MODE=live. A hub is read only once its domain's
# terms_review_outcome is recorded as allowing it.
CORPORATE_DOORS_MODE=off
CORPORATE_DOOR_KINDS_LIVE=
CORPORATE_DOOR_FLAG_PAYCO=false
